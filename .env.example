# Railway postgres:// yoki postgresql:// bersa ham avtomatik postgresql+asyncpg ga o‘giriladi
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/million_istighfor
TELEGRAM_BOT_TOKEN=
# WebApp URL (BotFather Menu Button / inline web_app — HTTPS kerak)
TELEGRAM_WEBAPP_URL=https://your-app.example.com/
# Production: Railway public URL (webhook uchun)
TELEGRAM_WEBHOOK_BASE_URL=
# Webhook himoyasi (majburiy — setWebhook va POST /api/telegram/webhook)
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_ENABLED=true
# webhook = FastAPI webhook; polling = python -m app.bot.worker (eslatmalar shu yerda); off = bot o‘chiq
TELEGRAM_BOT_MODE=webhook
DISPLAY_TIMEZONE=Asia/Tashkent
# Production WebApp (masalan Railway)
# TELEGRAM_WEBAPP_URL=https://zikir-production.up.railway.app/
DEBUG=true
DEV_TELEGRAM_ID=123456789
# Vergul bilan admin Telegram ID lar (DEV profildan farqli bo‘lishi mumkin).
ADMIN_TELEGRAM_IDS=
